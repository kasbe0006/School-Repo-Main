# Copy this file to `.env` and change the values.
# Lines starting with # are comments.

# Path of the SQLite database file (relative paths are relative to the project folder)
UCMS_DB_PATH=ucms.db

# Secret key used to sign JWT tokens. CHANGE THIS in any real deployment.
JWT_SECRET=change-this-to-a-long-random-string

# How many hours a login token stays valid
JWT_EXPIRE_HOURS=8

# Runtime mode. Use production only with a strong JWT_SECRET and a provisioned database.
ENVIRONMENT=development
AUTO_SEED=true
# Used only for the first production start when the database has no users.
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=

# Public school branding
SCHOOL_NAME=Your School Name
SCHOOL_SHORT_NAME=Your School
SCHOOL_TAGLINE=School management made simple

# Failed-login protection (per IP and email)
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# Where the web server listens
HOST=127.0.0.1
PORT=8000
